# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control
#
# Production values are Fly secrets on linknode-eagle-monitor (fly secrets list)
# and GitHub secrets; this file is only for local runs of fly/eagle-monitor.

# Fly.io Configuration
FLY_API_TOKEN=your-fly-api-token-here

# Eagle Monitor (fly/eagle-monitor/app.py)
PORT=5000
DB_PATH=./energy.db
EAGLE_PASSWORD=your-ingest-basic-auth-password
SLACK_WEBHOOK_URL=
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
