# linknode-watchdog environment: COPY, DO NOT COMMIT THE FILLED-IN VERSION.
#
# First install only, on the Pi, with this file copied to /tmp (see deploy/README.md):
#
#   [ -e /etc/linknode-watchdog.env ] || sudo install -m 0600 /tmp/linknode-watchdog.env.example /etc/linknode-watchdog.env
#   sudoedit /etc/linknode-watchdog.env     # fill in the real values
#
# The guard keeps a re-run from replacing the real credentials with these placeholders.
#
# The same Pushover application and user the Fly ingest service alerts through
# (its PUSHOVER_API_TOKEN / PUSHOVER_USER_KEY secrets).
PUSHOVER_API_TOKEN=REPLACE_WITH_PUSHOVER_APPLICATION_TOKEN
PUSHOVER_USER_KEY=REPLACE_WITH_PUSHOVER_USER_KEY

# --- Tuning ----------------------------------------------------------------
# Keep each setting on a line of its own, with nothing after the value. systemd
# does not strip a trailing "# comment": it becomes part of the value, and every
# pass then crashes before it runs a check.
#
# The backstop: age of the newest reading, in seconds, past which the watchdog fails
# its ingest check. The third failing pass in a row sends a siren of its own. Set to
# 24 hours, so it speaks only for an outage that is still open a day later, or when
# the Fly alarm has been silent. The script's own default is 900. Keep it well above
# the Fly service's STALE_THRESHOLD_MINUTES (30 minutes): at or below that, this siren
# comes within minutes of the alarm's.
WATCH_BACKSTOP_SECS=86400
#
# Optional (defaults shown; uncomment to change).
# Consecutive failed passes before an alert (passes are 2 min apart):
# WATCH_FAIL_THRESHOLD=3
#
# Alert priority. 2 = emergency siren, repeating every 60 s until acknowledged
# (Pushover stops it after 50 repeats, about 50 minutes); 1 = high; 0 = normal:
# WATCH_PRIORITY=2
