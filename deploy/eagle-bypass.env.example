# eagle-bypass environment: COPY, DO NOT COMMIT THE FILLED-IN VERSION.
#
# First install only, on the Pi, with this file copied to /tmp (see deploy/README.md):
#
#   [ -e /etc/eagle-bypass.env ] || sudo install -m 0600 /tmp/eagle-bypass.env.example /etc/eagle-bypass.env
#   sudoedit /etc/eagle-bypass.env          # fill in the real values
#
# The guard keeps a re-run from replacing the real credentials with these placeholders.
#
# All three secrets below are credentials. The Install Code also leaks the Wi-Fi
# PSK via the local API, so treat this file as sensitive.

# --- Eagle local API (read side) -------------------------------------------
EAGLE_IP=10.0.0.222
EAGLE_CLOUD_ID=00a046
EAGLE_INSTALL_CODE=REPLACE_WITH_INSTALL_CODE

# --- Fly /eagle upload (write side) ----------------------------------------
# EAGLE_UPLOAD_PASSWORD must equal the EAGLE_PASSWORD secret set on the Fly app
# (the same credential Rainforest's uploader uses). USER stays 'eagle' unless you
# overrode EAGLE_USERNAME on Fly.
EAGLE_UPLOAD_USER=eagle
EAGLE_UPLOAD_PASSWORD=REPLACE_WITH_FLY_EAGLE_PASSWORD
# Upload URL (default shown; override only to test). Put nothing after the value:
# systemd keeps a trailing "# comment" as part of it, and every upload then fails.
# EAGLE_UPLOAD_URL=https://linknode-eagle-monitor.fly.dev/eagle

# --- Optional tuning (defaults shown; uncomment to change) -----------------
# Pass tuning flags on ExecStart in the .service file, e.g.:
#   ExecStart=/usr/bin/python3 .../eagle_bypass.py --interval 30 --stale-secs 90 --probe-secs 300 -v
